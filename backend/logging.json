{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {"json": {"()": "app.utils.logging.JsonFormatter"}},
  "handlers": {"stdout": {"class": "logging.StreamHandler", "stream": "ext://sys.stdout", "formatter": "json"}},
  "root": {"handlers": ["stdout"], "level": "INFO"},
  "loggers": {
    "uvicorn": {"handlers": [], "propagate": true, "level": "INFO"},
    "uvicorn.error": {"handlers": [], "propagate": true, "level": "INFO"},
    "uvicorn.access": {"handlers": [], "propagate": false},
    "httpx": {"level": "WARNING"},
    "httpcore": {"level": "WARNING"},
    "authlib": {"level": "WARNING"}
  }
}
