# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite+aiosqlite:///./ucm_newsletter.db
# Docker/shared Postgres example:
# DATABASE_URL=postgresql+asyncpg://ucm:<password>@insight-db:5432/ucm_newsletter_dev

# LLM Provider ("claude", "openai", or "mindrouter")
LLM_PROVIDER=claude

# Anthropic (required when LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# OpenAI (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# AI edit task processing
AI_EDIT_MAX_CONCURRENCY=2

# MindRouter — University of Idaho on-prem AI (required when LLM_PROVIDER=mindrouter)
MINDROUTER_API_KEY=
MINDROUTER_ENDPOINT_URL=https://mindrouter.uidaho.edu/v1/chat/completions
MINDROUTER_MODEL=openai/gpt-oss-120b

# Ops needs classifier — always MindRouter, independent of LLM_PROVIDER.
# Endpoint and key fall back to the MINDROUTER_* values when unset.
OPS_CLASSIFIER_MODEL=qwen/qwen3.8-27b
OPS_CLASSIFIER_ENDPOINT_URL=
OPS_CLASSIFIER_API_KEY=

# File uploads
ENVIRONMENT=development
UPLOAD_DIR=./uploads
IMAGE_UPLOAD_MAX_BYTES=10485760
IMAGE_UPLOAD_MAX_PIXELS=36000000

# Authentication
#   header = the reverse proxy asserts a role via X-Trusted-User-Role +
#            X-Trusted-Auth-Secret (the prototype boundary; the default)
#   oidc   = Microsoft Entra ID sign-in (Web/confidential flow); users sign
#            in with their University account and the app maps their Entra
#            App Role to staff / slc / ops
AUTH_PROVIDER=header

# Trusted auth boundary (AUTH_PROVIDER=header)
# Set this to the shared secret used by your reverse proxy or auth gateway when
# it injects X-Trusted-User-Role and X-Trusted-Auth-Secret.
TRUSTED_ROLE_HEADER_SECRET=
# Prototype deployments can assert one role for all proxied API traffic.
# Leave blank for public-only behavior; set to "staff" to expose editor tools.
TRUSTED_ROLE_HEADER_ROLE=

# Session token (AUTH_PROVIDER=oidc). Signs the token the browser holds after
# sign-in. Must be changed and >= 32 chars in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production-min-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Microsoft Entra registration (required when AUTH_PROVIDER=oidc). OIT
# registers this app as a "Web" (confidential) client and delivers the secret
# via 1Password; it expires 24 months after issue, so track the rotation date.
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# OIDC discovery document, e.g.
# https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
ENTRA_METADATA_URL=
# Registered with OIT character-for-character, one per environment. Entra
# sends the browser here, so it must be the public hostname:
#   local dev (Vite):  http://localhost:5173/api/v1/auth/callback
#   deployed dev:      https://ucmnews-dev.insight.uidaho.edu/api/v1/auth/callback
#   prod:              https://ucmnews.insight.uidaho.edu/api/v1/auth/callback
ENTRA_REDIRECT_URI=http://localhost:5173/api/v1/auth/callback
# Where the backend then sends the browser (the frontend callback page).
OIDC_POST_LOGIN_REDIRECT=http://localhost:5173/sso/callback
# Where Entra returns the browser after sign-out.
OIDC_POST_LOGOUT_REDIRECT=http://localhost:5173/
OIDC_SCOPES=openid email profile
# Where the user's role comes from:
#   claim — Entra App Roles on the registration; their names arrive in the
#           OIDC_ROLE_CLAIM claim. The default; needs no extra permission.
#   graph — call Microsoft Graph /me/memberOf for security-group names.
#           Needs the delegated GroupMember.Read.All scope (admin consent).
OIDC_GROUP_SOURCE=claim
OIDC_ROLE_CLAIM=roles
# App Role / group names that grant each role (comma-separated lists OK,
# case-insensitive). staff passes every gate; slc and ops only their own
# pages. A signed-in user matching none of them is refused.
ENTRA_GROUP_STAFF=
ENTRA_GROUP_SLC=
ENTRA_GROUP_OPS=
# Signs the OIDC-state cookie during sign-in. Must be set, and differ from
# SECRET_KEY, in production. Generate the same way as SECRET_KEY.
SESSION_COOKIE_SECRET=

# Frontend build context
VITE_APP_ENV=development

# University calendar source
CALENDAR_SOURCE_URL=https://www.qatrumba.com/events-calendar/ui/uidaho/vandals/vandal/event/events/calendar/moscow/idaho/id/university-of-idaho
CALENDAR_REQUEST_TIMEOUT_SECONDS=10.0

# University job postings source
JOB_POSTINGS_SOURCE_URL=https://uidaho.peopleadmin.com/postings/search
JOB_POSTINGS_REQUEST_TIMEOUT_SECONDS=10.0
JOB_POSTINGS_MAX_PAGES=5

# CORS (comma-separated origins; JSON arrays are also supported)
CORS_ORIGINS=http://localhost:5173

# Reference-data seeding (runs on every backend container start).
# Existing rows are never modified by default so staff edits made in the app
# survive redeploys. Set to 1 to deliberately reset style rules, allowed
# values, and schedule configs to the JSON files in backend/data/.
SEED_OVERWRITE=

# Feedback notifications
# Phase one records delivery state and surfaces new reports in the staff UI,
# but sends no data outside the application. Keep disabled until UCM/OIT
# approves and the codebase adds a specific outbound adapter.
FEEDBACK_NOTIFICATION_CHANNEL=disabled
